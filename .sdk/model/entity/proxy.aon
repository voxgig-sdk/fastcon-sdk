# Entity: proxy

main: kit: entity: proxy: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Unique identifier for the proxy server"
      type: "`$STRING`"
    }
    {
      name: "port"
      req: true
      short: "Proxy server port number"
      type: "`$INTEGER`"
    }
    {
      name: "secret"
      req: true
      short: "Secret key for proxy authentication"
      type: "`$STRING`"
    }
    {
      name: "server"
      req: true
      short: "Proxy server hostname or IP address"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "proxy"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/proxies"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "proxies"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
